# ══════════════════════════════════════════════
#  SaludIA — Frontend Environment Variables
#  Copia este archivo a .env y completa los valores
# ══════════════════════════════════════════════

# URL del backend (FastAPI)
# - Local:      http://localhost:8000
# - Producción: https://saludia-backend.onrender.com  (URL de Render)
VITE_BACKEND_URL=http://localhost:8000

# Supabase — obtén estos valores en:
# https://supabase.com/dashboard/project/<ref>/settings/api
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...  # Settings > API > anon (público — seguro en frontend)
